# Salin ke .env lalu isi nilai asli lingkungan Anda.
# Dipakai docker-compose untuk substitusi variabel (BUKAN env service Semaphore).
#   TELEPORT_PROXY_HOST = IP host yang menjalankan proxy Teleport
#   TELEPORT_PROXY_ALIAS = nama alias host proxy (harus sama dgn public_addr Teleport)
TELEPORT_PROXY_HOST=192.0.2.20
TELEPORT_PROXY_ALIAS=teleport-proxy
#   TELEPORT_CLUSTER = cluster_name di /etc/teleport.yaml
#   TELEPORT_NODE    = nodename Teleport dari node target (cek: tctl nodes ls)
TELEPORT_CLUSTER=example-cluster
TELEPORT_NODE=node
