# Semaphore Server Configuration (Template)
# Copy this file to .env.semaphore and fill in the actual production credentials.
# Note: .env.semaphore is ignored by git to prevent security leaks.

SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@example.com

# Semaphore Database Link
SEMAPHORE_DB_USER=Admin
SEMAPHORE_DB_PASS=YOUR_SECURE_DB_PASSWORD
SEMAPHORE_DB_HOST=db
SEMAPHORE_DB_PORT=5432
SEMAPHORE_DB_DIALECT=postgres
SEMAPHORE_DB=semaphore

SEMAPHORE_PLAYBOOK_PATH=/tmp/semaphore/playbooks

# Postgres Database Configuration (Template)
POSTGRES_USER=Admin
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=semaphore
