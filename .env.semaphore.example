SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@example.com

# Semaphore Database Link
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASS=CHANGE_ME_DB_PASSWORD
SEMAPHORE_DB_HOST=db
SEMAPHORE_DB_PORT=5432
SEMAPHORE_DB_DIALECT=postgres
SEMAPHORE_DB=semaphore

SEMAPHORE_PLAYBOOK_PATH=/tmp/semaphore/playbooks

# Postgres Database Configuration
POSTGRES_USER=semaphore
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=semaphore

# Bot Telegram notifikasi backup (kosongkan token = bot tidak aktif).
#   TELEGRAM_BOT_TOKEN : dari @BotFather
#   TELEGRAM_CHAT_ID   : chat/grup tujuan (cek lewat @userinfobot atau getUpdates)
#   TELEGRAM_ALLOWED_USER_IDS : id user yang boleh menekan tombol (default = chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_USER_IDS=
# BOT_SNOOZE_MINUTES=60

# Pengecekan harian stack backup di Portainer (BOT_CHECK_TIME 08:00, BOT_CHECK_DAYS Senin-Jumat).
# Kirim /cek ke bot untuk menjalankannya sekarang. Akun cukup read-only.
PORTAINER_URL=http://192.0.2.10:9000
PORTAINER_USER=
PORTAINER_PASSWORD=
# nama stack (compose project) yang dipantau, dipisah koma
PORTAINER_STACKS=backup_stack_a,backup_stack_b
# BOT_CHECK_TIME=08:00
# BOT_CHECK_DAYS=1-5        # 1=Senin ... 7=Minggu
# BOT_STALE_HOURS=30
# BOT_IGNORE_DBS=information_schema,performance_schema,sys
